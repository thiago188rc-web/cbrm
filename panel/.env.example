# RM GROWTH OS — variables de entorno.
# Copiá este archivo a .env.local y completalo. .env.local NO se sube al repo.
# En Vercel se cargan en Settings → Environment Variables del proyecto del panel.

# Supabase → Project Settings → API Keys / Data API
NEXT_PUBLIC_SUPABASE_URL=
# Clave publicable (sb_publishable_…). Viaja al navegador: es pública por diseño.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (sb_secret_…). Saltea RLS: solo servidor. NUNCA con NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Dirección pública del panel: arma los links de invitación y recuperación.
# Local: http://localhost:3000 · Producción: https://panel.cabinasdesarmablesrm.com
NEXT_PUBLIC_PANEL_URL=http://localhost:3000
